# CodeHub Control Plane Production Environment Template
# NEVER use localhost for DATABASE_URL in production environments.
# Secrets should be injected via a Secrets Manager (AWS Secrets Manager, HashiCorp Vault, Doppler, or Kubernetes Secrets).

NODE_ENV=production

PORT=4000

APP_URL=https://api.codehub.example
CLIENT_URL=https://codehub.example

DATABASE_URL=postgresql://codehub_user:${DB_PASSWORD}@postgres-cluster.production.internal:5432/codehub_prod?sslmode=require

REDIS_URL=rediss://default:${REDIS_PASSWORD}@redis-cluster.production.internal:6379

JWT_ACCESS_SECRET=PRODUCTION_STRICT_JWT_ACCESS_SECRET_REPLACE_WITH_SECRETS_MANAGER
JWT_REFRESH_SECRET=PRODUCTION_STRICT_JWT_REFRESH_SECRET_REPLACE_WITH_SECRETS_MANAGER

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

CORS_ORIGINS=https://codehub.example

SOCKET_PATH=/socket.io
