# ==============================================================================
# CodeHub Sovereign P2P Collaboration Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env (for local development) or .env.production (for production).
# In production, ensure all default passwords and secrets are replaced with secure keys.
# Generate secure keys using: openssl rand -base64 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
NODE_ENV=production
RUST_LOG=info,codehub_server=debug,p2p_engine=info

HOST=0.0.0.0
PORT=8080
API_PORT=8080
P2P_PORT=4001

# Public Server Domain & URLs (used by reverse proxy and clients)
CODEHUB_DOMAIN=codehub.p2p
APP_DOMAIN=app.codehub.p2p
API_DOMAIN=api.codehub.p2p
P2P_DOMAIN=p2p.codehub.p2p

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codehub
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=codehub_db

# Standard PostgreSQL connection string used by API services
DATABASE_URL=postgres://codehub:replace_with_strong_password_in_production@postgres:5432/codehub_db

# ------------------------------------------------------------------------------
# 3. Cache & PubSub (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_strong_redis_password_in_production

# Standard Redis connection string
REDIS_URL=redis://:replace_with_strong_redis_password_in_production@redis:6379

# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Tokens
# ------------------------------------------------------------------------------
# Secret key used for signing JWT access tokens (HMAC-SHA256)
# Generate via: openssl rand -base64 48
JWT_SECRET=replace_with_secure_production_jwt_secret_min_32_characters

# JWT Expiration lifetimes
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=30d

# Permitted CORS origins (comma-separated, or * in dev)
CORS_ALLOWED_ORIGINS=https://app.codehub.p2p,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# 5. P2P Swarm & Libp2p Network Settings
# ------------------------------------------------------------------------------
# Storage path where peer node maintains local Git DAG chunks and multihashes
P2P_STORAGE_PATH=~/.codehub/storage

# Persistent 32-byte Ed25519 secret seed for deterministic node Peer ID (Base64)
# Generate via: openssl rand -base64 32
P2P_NODE_PRIVATE_KEY=replace_with_base64_32_byte_ed25519_seed

# Default replication factor (number of active swarm peer copies per chunk)
MIN_REPLICATION_FACTOR=3
TARGET_REPLICATION_FACTOR=9

# Bootstrap Rendezvous Peer Multiaddrs (comma-separated)
P2P_BOOTSTRAP_PEERS=/dns4/p2p.codehub.p2p/tcp/4001/p2p/12D3KooWControlRelayServer

# ------------------------------------------------------------------------------
# 6. Flutter Frontend Client Endpoints (Compile-time / runtime config)
# ------------------------------------------------------------------------------
API_BASE_URL=https://api.codehub.p2p/api/v1
SOCKET_URL=https://api.codehub.p2p
SOCKET_WS_URL=wss://api.codehub.p2p/api/v1/events/ws
P2P_BOOTSTRAP_RELAY_MULTIADDR=/dns4/p2p.codehub.p2p/tcp/4001/p2p/12D3KooWControlRelayServer

# ------------------------------------------------------------------------------
# 7. Reverse Proxy (Caddy / Nginx) & Monitoring
# ------------------------------------------------------------------------------
# Caddy ACME/Let's Encrypt TLS certificate administration email
CADDY_ACME_EMAIL=your-email@example.com
PROMETHEUS_METRICS_PORT=9090
