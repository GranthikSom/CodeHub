# Multi-stage Production Dockerfile for CodeHub Flutter Web Client
# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# 1. Flutter Build Stage
# ------------------------------------------------------------------------------
FROM debian:bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Clone Flutter stable SDK
RUN git clone https://github.com/flutter/flutter.git -b stable --depth 1 /usr/local/flutter
ENV PATH="/usr/local/flutter/bin:${PATH}"

RUN flutter doctor -v

WORKDIR /app
COPY apps/flutter_app/pubspec.* ./
RUN flutter pub get

COPY apps/flutter_app/ ./
RUN flutter build web --release

# ------------------------------------------------------------------------------
# 2. Production Nginx Serving Stage
# ------------------------------------------------------------------------------
FROM nginx:alpine AS runner

COPY infrastructure/nginx/web_nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/build/web /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
